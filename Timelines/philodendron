   "transform": [
    {
     "type": "filter",
     "expr": "includeArrows && datum['category'] === 'serpentine'"
    },
    {
     "type": "joinaggregate",
     "fields": [
      "id",
      "id"
     ],
     "ops": [
      "min",
      "max"
     ],
     "groupby": [
      "i"
     ],
     "as": [
      "minId",
      "maxId"
     ]
    },
    {
     "type": "filter",
     "expr": "datum['id'] === (reverse ? datum['maxId'] : datum['minId'])"
    }
   ]
  },
  {
   "name": "milestones",
   "source": "componentEncodings",
   "transform": [
    {
     "type": "filter",
     "expr": "datum['category'] === 'milestone'"
    },
    {
     "type": "lookup",
     "key": "domain",
     "from": "dataset",
     "fields": [
      "domain"
     ],
     "values": [
      "label",
      "color"
     ]
    },
    {
     "type": "formula",
     "expr": "(isValid(hoverFocus) && hoverFocus['domain'] === datum['domain']) ? 1 : (isValid(hoverFocus) && hoverFocus['domain'] !== datum['domain']) ? 0.4 : 0",
     "as": "fillOpacity"
    },
    {
     "type": "formula",
     "expr": "min(15, length(split(datum['label'], ',')))",
     "as": "eventCount"
    },
    {
     "type": "window",
     "ops": [
      "row_number"
     ],
     "sort": {
      "field": "domain"
     },
     "as": [
      "id"
     ]
    },
    {
     "type": "formula",
     "expr": "10 + 200 * datum['eventCount']",
     "as": "size"
    },
    {
     "type": "formula",
     "expr": "length(split(datum['label'], ',')) > 15 ? join(slice(split(datum['label'], ','), 0, 15), ',') + ', +' + (length(split(datum['label'], ',')) - 15) + ' more' : datum['label']",
     "as": "displayLabel"
    },
    {
     "type": "lookup",
     "from": "label_metrics",
     "key": "domain",
     "fields": [
      "domain"
     ],
     "values": [
      "boxW",
      "boxH",
      "lineCount"
     ]
    },
    {
     "type": "collect",
     "sort": {
      "field": "size",
      "order": "descending"
     }
    }
   ]
  }
 ],
 "autosize": {
  "type": "none"
 },
 "config": {
  "font": "IBM Plex Mono",
  "text": {
   "font": "IBM Plex Mono"
  }
 }
